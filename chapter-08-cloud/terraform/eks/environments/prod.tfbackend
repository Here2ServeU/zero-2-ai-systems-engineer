# Backend settings for the prod EKS state file. Same bucket + lock table as
# Chapter 08; only the key differs. The bucket name is added at init:
#   terraform init -reconfigure \
#     -backend-config=environments/prod.tfbackend \
#     -backend-config="bucket=$(terraform -chdir=../backend output -raw state_bucket)"
key            = "eks/prod/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "zero2ai-terraform-locks"
encrypt        = true
