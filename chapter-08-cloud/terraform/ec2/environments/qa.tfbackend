# Backend settings for the qa state file. The bucket name is added at init:
#   terraform init -reconfigure \
#     -backend-config=environments/qa.tfbackend \
#     -backend-config="bucket=$(terraform -chdir=../backend output -raw state_bucket)"
key            = "ec2/qa/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "zero2ai-terraform-locks"
encrypt        = true
