# Backend settings for the qa EKS state file. Chapter 10's own bucket + lock
# table (terraform/backend); only the key differs. The bucket name is added at init:
#   terraform init -reconfigure \
#     -backend-config=environments/qa.tfbackend \
#     -backend-config="bucket=$(terraform -chdir=../backend output -raw state_bucket)"
key            = "eks/qa/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "zero2ai-eks-terraform-locks"
encrypt        = true
